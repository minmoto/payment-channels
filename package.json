{
  "name": "@minmoto/payment-channels",
  "version": "0.5.0",
  "description": "Open registry and validation toolkit for fiat payment channel schemas.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minmoto/payment-channels.git"
  },
  "homepage": "https://github.com/minmoto/payment-channels#readme",
  "bugs": {
    "url": "https://github.com/minmoto/payment-channels/issues"
  },
  "keywords": [
    "payment-channels",
    "fiat",
    "mobile-money",
    "registry",
    "validation",
    "minmoto"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/finalize-build.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "docs:generate": "npm run build && node scripts/generate-registry-docs.mjs",
    "docs:check": "node scripts/generate-registry-docs.mjs --check",
    "examples:check": "node examples/generic-consumer.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run docs:check && npm run examples:check && node --test",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{cjs,js,json,md,mjs,ts,yaml,yml}": "prettier --write"
  }
}
