  {
    "id": "mpesa_phone_ke_kes",
    "version": 2,
    "display": {
      "label": "M-Pesa phone",
      "shortLabel": "M-Pesa",
      "description": "Safaricom M-Pesa wallet transfer to a Kenyan phone number.",
      "icon": "mpesa",
      "group": "mobile_money"
    },
    "network": { "id": "mpesa", "label": "M-Pesa", "country": "KE", "currency": "KES" },
    "support": { "automation": "api" },
    "fields": [
      {
        "key": "phoneNumber",
        "label": "Phone number",
        "type": "phone",
        "required": true,
        "sensitive": true,
        "mask": "phone",
        "normalize": ["trim", "e164_ke_phone"],
        "placeholder": "+254712345678",
        "validation": [
          {
            "kind": "pattern",
            "pattern": "^\\+254[0-9]{9}$",
            "message": "Use a Kenyan phone number in international format, e.g. +254712345678"
          }
        ]
      },
      {
        "key": "description",
        "label": "Description",
        "type": "text",
        "required": false,
        "normalize": ["trim"],
        "validation": [{ "kind": "max_length", "length": 100 }]
      }
    ],
    "detailRows": [{ "key": "phoneNumber", "label": "Phone number", "fields": ["phoneNumber"], "copyable": true }],
    "instructions": {
      "payer": ["Send the exact amount to the displayed M-Pesa phone number."],
      "payee": ["Confirm the M-Pesa reference is available if the payment is disputed."]
    },
    "evidence": [
      {
        "key": "transactionReference",
        "label": "Transaction reference",
        "type": "text",
        "required": true,
        "validation": [{ "kind": "min_length", "length": 3 }]
      }
    ]
  },
